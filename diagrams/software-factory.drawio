<mxfile host="build_drawio.py"><diagram id="p0" name="1. Quy trình 8 bước"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style='font-size:22px'&gt;Vòng đời một feature trong AI Software Factory (8 bước, 2 gate người)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;Đồng thuận: research R 5/5 · video V 11/13 (checkpoint người), V 12/13 (harness kiểm chứng). Mũi tên đứt = vòng lặp sửa lỗi.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1500" height="60" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;👤 Con người&lt;br&gt;(PM · Tech lead · Reviewer)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="150" height="200" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="180" y="90" width="1790" height="200" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;🤖 AI agent&lt;br&gt;(coder · reviewer · test designer)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="150" height="200" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="180" y="300" width="1790" height="200" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;⚙️ Code tất định / CI&lt;br&gt;(script · hook · pipeline)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="30" y="510" width="150" height="200" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="180" y="510" width="1790" height="200" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;1. Brief&lt;/b&gt;&lt;br&gt;mục tiêu + acceptance criteria đo được" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="200" y="135" width="190" height="110" as="geometry"/></mxCell><mxCell id="c9" value="Agent &lt;b&gt;phỏng vấn&lt;/b&gt; người, khảo sát code&lt;br&gt;&lt;i style='font-size:10px'&gt;(loại giả định ngầm — v13)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="345" width="190" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;2. Plan / Spec&lt;/b&gt;&lt;br&gt;plan.md (task nhỏ) hoặc specs/*.md (feature lớn), đọc code read-only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="420" y="345" width="190" height="110" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Gate 1&lt;/b&gt;&lt;br&gt;TL duyệt plan&lt;br&gt;&lt;span style='font-size:10px'&gt;trọng tâm: chiến lược kiểm chứng&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="415" y="115" width="200" height="150" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;3. Breakdown&lt;/b&gt;&lt;br&gt;task ≤ 1 PR (~30' review), không chồng file&lt;br&gt;+ &lt;b&gt;test chấp nhận viết trước&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="345" width="190" height="110" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Khoá test&lt;/b&gt;&lt;br&gt;hook/CI chặn sửa test, CI config, lockfile" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="555" width="190" height="110" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;4. Implement&lt;/b&gt;&lt;br&gt;1 agent · 1 worktree · 1 sandbox&lt;br&gt;plan → code → test + bằng chứng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="345" width="190" height="110" as="geometry"/></mxCell><mxCell id="c15" value="WIP: 2–3 agent / dev&lt;br&gt;(tăng khi review theo kịp)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="860" y="140" width="190" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;5. Gate tự động&lt;/b&gt;&lt;br&gt;lint · type · test · SAST · secret scan · trùng lặp · chặn dependency mới" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="555" width="190" height="110" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;6. AI review&lt;/b&gt;&lt;br&gt;context sạch, &lt;b&gt;model khác&lt;/b&gt;, đối chiếu spec, gắn nhãn rủi ro, before/after" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1300" y="345" width="190" height="110" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Gate 2&lt;/b&gt;&lt;br&gt;Người review + approve&lt;br&gt;&lt;span style='font-size:10px'&gt;không phải người giao task&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1515" y="115" width="200" height="150" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;8. Deploy&lt;/b&gt;&lt;br&gt;feature flag / canary&lt;br&gt;(rollout bằng code)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1740" y="555" width="190" height="110" as="geometry"/></mxCell><mxCell id="c20" value="Theo dõi metric/log khi rollout&lt;br&gt;Sentry / incident → &lt;b&gt;ticket mới&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1740" y="345" width="190" height="110" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Retro tuần&lt;/b&gt;&lt;br&gt;lỗi lặp ≥2 lần → rule AGENTS.md / hook / eval case" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1740" y="135" width="190" height="110" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="duyệt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="735.0" y="190"/></Array></mxGeometry></mxCell><mxCell id="c26" value="sửa plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="625" y="190"/><mxPoint x="625" y="400"/></Array></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="955.0" y="610"/></Array></mxGeometry></mxCell><mxCell id="c30" value="fail (≤2–3 vòng)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="c16" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1175.0" y="470"/><mxPoint x="1050" y="470"/></Array></mxGeometry></mxCell><mxCell id="c31" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1395.0" y="610"/></Array></mxGeometry></mxCell><mxCell id="c32" value="comment → sửa (vòng có giới hạn)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="c17" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1395.0" y="320"/><mxPoint x="955.0" y="320"/></Array></mxGeometry></mxCell><mxCell id="c33" value="bot hài lòng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1495" y="400"/><mxPoint x="1495" y="190"/></Array></mxGeometry></mxCell><mxCell id="c34" value="merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1615.0" y="610"/></Array></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="ticket mới (khép vòng production)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="c20" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1950" y="400"/><mxPoint x="1950" y="75"/><mxPoint x="295.0" y="75"/></Array></mxGeometry></mxCell><mxCell id="c38" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;🟨 người · 🟦 agent · 🟩 code tất định/CI · 🔶 gate người&lt;br&gt;Bug nhỏ: bỏ spec đầy đủ, chỉ cần plan ngắn. Low-risk auto-merge chỉ thử từ tháng 3 (xem trang 4)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="740" width="900" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2. Kiến trúc factory"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style='font-size:22px'&gt;Kiến trúc: code tất định điều phối, agent chỉ làm phần cần phán đoán&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;&quot;Agent proposes, code disposes&quot; — V1 (6/13 video). Cô lập worktree/sandbox — R 5/5 · V 8/13. Model routing — V3 (7/13).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1500" height="60" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Nguồn việc&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Issue tracker&lt;br&gt;(nhãn agent-ok / risk)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="220" height="60" as="geometry"/></mxCell><mxCell id="c4" value="Spec / plan đã duyệt" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="220" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Job định kỳ: bug finder, watchdog, lookback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="60" as="geometry"/></mxCell><mxCell id="c6" value="Sentry · incident · feedback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="375" width="220" height="60" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;fillColor=#f3faf1;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="520" height="470" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;CONTROL PLANE — code tất định&lt;/b&gt; (không tốn token)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="335" y="108" width="480" height="25" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Hàng đợi task&lt;/b&gt;&lt;br&gt;trạng thái = label / file" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="345" y="145" width="220" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Phân loại&lt;/b&gt;&lt;br&gt;độ khó + rủi ro (DB/infra/auth = cao)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="595" y="145" width="220" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Model router&lt;/b&gt;&lt;br&gt;plan/review: model mạnh&lt;br&gt;scan/worker: model rẻ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="345" y="255" width="220" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Dispatcher&lt;/b&gt;&lt;br&gt;WIP limit · ngân sách token · retry" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="595" y="255" width="220" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Telemetry&lt;/b&gt;&lt;br&gt;log mọi lần chạy: token · thời gian · pass rate · cost/PR · DORA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="345" y="365" width="220" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Gates + CI&lt;/b&gt;&lt;br&gt;lint · type · test · SAST · secret · khoá test · branch protection · max vòng lặp" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="595" y="365" width="220" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Rollout&lt;/b&gt;&lt;br&gt;flag / canary / rollback" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="345" y="475" width="220" height="70" as="geometry"/></mxCell><mxCell id="c16" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;fillColor=#f2f6fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="100" width="560" height="470" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;DATA PLANE — agent trong sandbox&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="915" y="108" width="480" height="25" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="920" y="145" width="320" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;span style='font-size:10px'&gt;sandbox 1 · worktree + container · egress allowlist&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="925" y="147" width="310" height="20" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Coder agent&lt;/b&gt; (task 1)&lt;br&gt;plan → code → test" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="935" y="175" width="290" height="50" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="920" y="250" width="320" height="90" as="geometry"/></mxCell><mxCell id="c22" value="&lt;span style='font-size:10px'&gt;sandbox 2 · worktree + container · egress allowlist&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="925" y="252" width="310" height="20" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Coder agent&lt;/b&gt; (task 2)&lt;br&gt;plan → code → test" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="935" y="280" width="290" height="50" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1"><mxGeometry x="920" y="355" width="320" height="90" as="geometry"/></mxCell><mxCell id="c25" value="&lt;span style='font-size:10px'&gt;sandbox 3 · worktree + container · egress allowlist&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="925" y="357" width="310" height="20" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Coder agent&lt;/b&gt; (task 3)&lt;br&gt;plan → code → test" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="935" y="385" width="290" height="50" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Test designer&lt;/b&gt;&lt;br&gt;viết test chấp nhận trước; coder không sửa được" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1270" y="145" width="175" height="90" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Reviewer agent&lt;/b&gt;&lt;br&gt;model khác hãng&lt;br&gt;context sạch&lt;br&gt;đối chiếu spec&lt;br&gt;gắn nhãn rủi ro" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1270" y="255" width="175" height="125" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Không&lt;/b&gt; chia vai PM/Architect/Dev kiểu bầy agent — 1 coder mạnh / task" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="920" y="480" width="320" height="50" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Git repo = nguồn sự thật&lt;/b&gt;: AGENTS.md ngắn (mục lục) · specs/ · tasks · eval nội bộ 20–50 case" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="900" y="620" width="560" height="60" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Con người&lt;/b&gt;&lt;br&gt;Gate 1: duyệt plan&lt;br&gt;Gate 2: review PR&lt;br&gt;Retro tuần" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1580" y="252" width="200" height="130" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Production&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="345" y="620" width="220" height="60" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="295" y="180"/><mxPoint x="295" y="180"/></Array></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="295" y="255"/><mxPoint x="295" y="180"/></Array></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="295" y="330"/><mxPoint x="295" y="180"/></Array></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="295" y="405"/><mxPoint x="295" y="180"/></Array></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="giao task" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c12" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="khoá" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c27" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="PR (mỗi task)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#82b366;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c26" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="pass → PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#9673a6;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c14" target="c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="705" y="590"/><mxPoint x="1357" y="590"/></Array></mxGeometry></mxCell><mxCell id="c44" value="PR + bằng chứng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c28" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="approve → merge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="c31" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1680" y="760"/><mxPoint x="590" y="760"/><mxPoint x="590" y="510"/></Array></mxGeometry></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c15" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="lỗi → ticket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c32" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="650"/></Array></mxGeometry></mxCell><mxCell id="c48" value="&lt;b&gt;Ranh giới bảo mật&lt;/b&gt; (R 5/5): không session nào có đủ &lt;i&gt;lethal trifecta&lt;/i&gt; — dữ liệu riêng + input không tin cậy + kênh ra ngoài. Dependency mới phải có người duyệt (slopsquatting 19,7%). Không chạy --yolo ngoài sandbox." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="820" height="70" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Chi phí&lt;/b&gt;: multi-agent ~15× token → chỉ bật cho task chia được, có ngân sách theo team. Kiểm chứng tốn ~40% thời gian một mission (v04) — dồn ngân sách vào kiểm chứng, không vào số worker." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="790" width="820" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3. Lộ trình 3 tháng"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="680" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style='font-size:22px'&gt;Lộ trình 3 tháng cho team 3–10 kỹ sư&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;Mỗi giai đoạn chỉ sang bước tiếp khi đạt tiêu chí thoát. Ngưỡng % là suy luận — hiệu chỉnh theo baseline của team.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1500" height="60" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b style='font-size:15px'&gt;Tháng 1 — Nền móng “agent-ready”&lt;/b&gt;&lt;br&gt;&lt;i&gt;Một agent làm tốt trên repo; đo được&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="520" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style='text-align:left'&gt;• AGENTS.md ngắn (lệnh build/test, quy ước, gotcha)&lt;br&gt;• devcontainer / init.sh tái lập được&lt;br&gt;• CI nhanh (&amp;lt;10 phút) + check test integrity&lt;br&gt;• Sandbox + network allowlist&lt;br&gt;• Mỗi dev: 1 agent tương tác, plan→implement→verify&lt;br&gt;• &lt;b&gt;Baseline DORA + thời gian review&lt;/b&gt;&lt;br&gt;• Eval nội bộ 20–50 case từ PR đã đóng&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="185" width="520" height="165" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Tiêu chí thoát&lt;/b&gt;&lt;br&gt;CI tin cậy · có baseline · CI chặn sửa test &amp; dependency lạ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="365" width="520" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:15px'&gt;Tháng 2 — Có cấu trúc + async&lt;/b&gt;&lt;br&gt;&lt;i&gt;Spec, verify, việc vặt chạy nền&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="520" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;div style='text-align:left'&gt;• Chạy đủ 8 bước cho 1–2 feature thật&lt;br&gt;• Reviewer agent model khác trong CI&lt;br&gt;• Nhãn &lt;i&gt;agent-ok&lt;/i&gt;: bug có repro, bump dependency, test, docs → background agent&lt;br&gt;• Policy kích thước PR&lt;br&gt;• WIP ≤ 2–3 agent ghi / dev&lt;br&gt;• Người duyệt &lt;b&gt;100%&lt;/b&gt; PR&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="620" y="185" width="520" height="165" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Tiêu chí thoát&lt;/b&gt;&lt;br&gt;≥ ~50% PR agent merge với ít chỉnh sửa · review time tăng ≤ 25–30%" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="620" y="365" width="520" height="70" as="geometry"/></mxCell><mxCell id="c8" value="đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="400"/><mxPoint x="590" y="135"/></Array></mxGeometry></mxCell><mxCell id="c9" value="&lt;b style='font-size:15px'&gt;Tháng 3 — Song song có kiểm soát&lt;/b&gt;&lt;br&gt;&lt;i&gt;Factory nhỏ, dùng chung cả team&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1200" y="100" width="520" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style='text-align:left'&gt;• Dây chuyền bằng code tất định (queue, gate, retry)&lt;br&gt;• Orchestrator–worker cho feature chia được module&lt;br&gt;• Model routing theo pha · best-of-N chỉ khi có oracle&lt;br&gt;• Ephemeral devbox không secrets prod&lt;br&gt;• Sentry/incident → ticket · telemetry · dashboard cost/PR&lt;br&gt;• Thử auto-merge &lt;b&gt;danh mục hẹp&lt;/b&gt; nếu CFR ổn định&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1200" y="185" width="520" height="165" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Tiêu chí thoát&lt;/b&gt;&lt;br&gt;CFR không tăng · cost/PR trong ngân sách · 0 sự cố bảo mật · quyết định bằng dữ liệu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1200" y="365" width="520" height="70" as="geometry"/></mxCell><mxCell id="c12" value="đạt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1170" y="400"/><mxPoint x="1170" y="135"/></Array></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;Rủi ro phải chặn từ ngày đầu&lt;/b&gt;&lt;br&gt;① Reward hacking test → test viết trước + khoá bằng CI &amp;nbsp; ② Review fatigue → WIP limit, PR nhỏ, AI lọc trước &amp;nbsp; ③ Prompt injection / rò secrets → sandbox, tránh lethal trifecta &amp;nbsp; ④ Slopsquatting → chặn dependency mới &amp;nbsp; ⑤ Nợ kỹ thuật → linter trùng lặp + dọn định kỳ &amp;nbsp; ⑥ Ảo tưởng năng suất → quyết định theo telemetry" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="465" width="1680" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Công cụ tối thiểu&lt;/b&gt;: 1 coding agent CLI (hook, subagent, worktree) · 1 model khác hãng để review · 1 async agent gắn tracker · Git có branch protection + merge queue · SAST + secret scan + dependency allowlist · devcontainer/Docker · dashboard DORA/review/cost. &lt;b&gt;Chưa cần&lt;/b&gt; framework multi-agent nặng." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="565" width="1680" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4. Bản đồ đồng thuận"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style='font-size:22px'&gt;Research (5 báo cáo) × Video (13 video): chỗ nào đồng thuận, chỗ nào chỉ một bên nói, chỗ nào căng&lt;/b&gt;&lt;br&gt;&lt;span style='color:#666'&gt;R = số báo cáo research ủng hộ /5 · V = số video ủng hộ /13 (điểm có trích dẫn transcript). Người chấm phụ agy: κ = 0,43, chấm dễ hơn.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1500" height="60" as="geometry"/></mxCell><mxCell id="c2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=45;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="780" height="560" as="geometry"/></mxCell><mxCell id="c3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;opacity=45;" vertex="1" parent="1"><mxGeometry x="440" y="110" width="780" height="560" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style='font-size:16px'&gt;Chỉ research nói&lt;/b&gt;&lt;br&gt;&lt;span style='color:#b85450'&gt;(điểm mù của video)&lt;/span&gt;&lt;br&gt;&lt;br&gt;• Reward hacking → khoá test (R5 · V2)&lt;br&gt;• Slopsquatting / supply chain (R5 · V1)&lt;br&gt;• Prompt injection, lethal trifecta (R5 · V4◐)&lt;br&gt;• Ảo tưởng năng suất, METR −19% (R4 · V0)&lt;br&gt;• Benchmark công khai nhiễm (R5 · V2)&lt;br&gt;• AI khuếch đại team (DORA) (R4 · V1)&lt;br&gt;• Chia task theo ranh giới file (R4 · V2)&lt;br&gt;• WIP limit 2–5 agent/người (R5 · V2, ✗ v06 v10)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="85" y="230" width="345" height="330" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:16px'&gt;Lõi đồng thuận&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Harness kiểm chứng quyết định chất lượng &lt;b&gt;R5 · V12&lt;/b&gt;&lt;br&gt;• Pipeline có cấu trúc &lt;b&gt;R5 · V11&lt;/b&gt;&lt;br&gt;• Gate người: plan + PR &lt;b&gt;R5 · V11&lt;/b&gt;&lt;br&gt;• 1 agent mạnh viết code &lt;b&gt;R4 · V10&lt;/b&gt;&lt;br&gt;• Context engineering &lt;b&gt;R5 · V9&lt;/b&gt;&lt;br&gt;• Reviewer độc lập / model khác &lt;b&gt;R5 · V9&lt;/b&gt;&lt;br&gt;• Worktree / sandbox &lt;b&gt;R5 · V8&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="465" y="255" width="340" height="330" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:16px'&gt;Chỉ video nói&lt;/b&gt;&lt;br&gt;&lt;span style='color:#2d7600'&gt;(tầng vận hành factory)&lt;/span&gt;&lt;br&gt;&lt;br&gt;• Model routing theo pha (V3 · 7 video)&lt;br&gt;• Code tất định điều phối (V1 · 6)&lt;br&gt;• Khép vòng production → ticket (V4 · 5)&lt;br&gt;• Kiểm chứng E2E thật, ~40% (V7 · 5)&lt;br&gt;• Định tuyến theo rủi ro (V2 · 4)&lt;br&gt;• Vệ sinh context, nạp tool dần (V11 · 4)&lt;br&gt;• Bot-review có giới hạn vòng (V6 · 3)&lt;br&gt;• Tự xây skill nhỏ, không framework (V20 · 3)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="840" y="230" width="350" height="330" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:15px;color:#6c8ebf'&gt;RESEARCH · 5 báo cáo&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="150" y="140" width="250" height="30" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:15px;color:#2d7600'&gt;VIDEO · 13 practitioner&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="140" width="260" height="30" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:15px'&gt;3 điểm căng — team cần quyết&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1360" y="110" width="400" height="45" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Auto-merge PR rủi ro thấp?&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Research: người duyệt 100% (Stripe)&lt;br&gt;Video: 4/13 cho auto-merge&lt;/span&gt;&lt;br&gt;&lt;b style='color:#2d7600'&gt;→ Tháng 1–2 duyệt 100%; tháng 3 thử danh mục hẹp; DB/infra/auth luôn cần người&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1360" y="170" width="400" height="145" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Song song bao nhiêu?&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Research: 2–5 agent/người&lt;br&gt;Video: 15–20 task (v06, v10, không số đo)&lt;/span&gt;&lt;br&gt;&lt;b style='color:#2d7600'&gt;→ Giữ WIP limit&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1360" y="330" width="400" height="145" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Máy dev hay sandbox?&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Research: sandbox cô lập&lt;br&gt;Video v03: cần env thật trên laptop&lt;/span&gt;&lt;br&gt;&lt;b style='color:#2d7600'&gt;→ Env tái lập được; nếu chạy máy thật: cấm egress tự do, không secrets prod&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1360" y="490" width="400" height="145" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Độ tin cậy nguồn&lt;/b&gt; — Research: paper, DORA, METR, blog kỹ thuật (URL đã kiểm tra; gpt-oss bị loại vì 10/17 link 404). Video: 3 video đạt 3/5 (Builder.io, Factory, HumanLayer), còn lại tutorial/demo; &lt;b&gt;không video nào có số đo có phương pháp&lt;/b&gt;. Khi hai bên khác nhau về rủi ro/số liệu → ưu tiên research; video có giá trị nhất ở pattern vận hành." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="1700" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>